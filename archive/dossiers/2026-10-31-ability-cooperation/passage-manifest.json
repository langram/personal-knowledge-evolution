        {
          "id": "S1P03",
          "kind": "source-adaptation",
          "text": "另一方面，让每个人都能够掌握关于自身和外部世界充足的信息，逐步认识自身的特点，了解自己的特长，同时提供充足的自由发展的时间和自由，用于自由发展自己偏好的能力。",
          "basis_refs": [
            "DEVELOPMENT-GOALS",
            "AUTHOR-REVISION",
            "INTEGRATION-REQUEST"
          ],
          "wording_author_approved": false,
          "ref": "DEVELOPMENT-GOALS",
          "source_role": "user",
          "source_span": [
            205,
            286
          ],
          "source_sha256": "193a3e72eface54c7daf1ef7e9a0fd8549e7c497284d3e9d428e97505f97ff32",
