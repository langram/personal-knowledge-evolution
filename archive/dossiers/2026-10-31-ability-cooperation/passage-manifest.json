          ]
        },
        {
          "id": "S1P26",
          "kind": "editorial-addition",
          "text": "这些功能需要在实际任务中逐步验证。AI给出的跨领域解释，需要相关参与者检查是否保留了原本的条件和含义；记录下来的贡献，也需要结合具体证据理解。公共知识系统的作用，是让讨论能够建立在可检查、可继续发展的基础上，让不同的人不必从头猜测对方已经做了什么。",
          "basis_refs": [
            "DEVELOPMENT-GOALS",
            "AUTHOR-REVISION",
            "INTEGRATION-REQUEST"
          ],
          "wording_author_approved": false,
          "section_span": [
            2905,
            3029
          ],
          "document_span": [
            84303,
            84427
          ]
        },
        {
          "id": "S1P27",
          "kind": "heading",
          "text": "#### 让专业优势服务于共同创造",
          "basis_refs": [
            "DEVELOPMENT-GOALS",
            "AUTHOR-REVISION",
            "INTEGRATION-REQUEST"
          ],
          "wording_author_approved": false,
          "section_span": [
            3031,
            3048
          ],
          "document_span": [
            84429,
            84446
          ]
        },
        {
          "id": "S1P28",
          "kind": "source-adaptation",
          "text": "通过因材施教、发挥自己的特长，再加上人们合作中形成的能力互补和信任，我希望系统能够减少被个别人支配的机会。这个目标要靠具体机制实现：个人能够获得成长的条件，专业判断能够发挥作用，而这些优势又不能自动变成对其他人的普遍支配权。",
          "basis_refs": [
            "DEVELOPMENT-GOALS",
            "AUTHOR-REVISION",
            "INTEGRATION-REQUEST"
          ],
          "wording_author_approved": false,
          "ref": "DEVELOPMENT-GOALS",
          "source_role": "user",
          "source_span": [
            467,
            512
          ],
          "source_sha256": "4a34912c4e6fae39b956f959f4d3e419f8abbc0dc13439674161c2cde4c5053e",
          "edits": [
            {
              "operation": "insert",
              "source_span": [
                467,
                467
              ],
              "before": "",
              "after": "通过因材施教、发挥自己的特长，再"
            },
            {
              "operation": "replace",
              "source_span": [
                484,
                485
              ],
              "before": "。",
