{
  "chapter": "07",
  "title": "机器、人工智能与平等的物质条件",
  "status": "expanded-copyedited",
  "review": {
    "reasoning": "工具缩小生理差异→使用条件决定收益→智力成果可复制→共同基础保留差异→生产关系调整→劳动与创造→公共知识",
    "examples": [
      "农业机械",
      "导航地图",
      "工匠与机器",
      "专家经验变成可检验工具",
      "个人电影创作"
    ],
    "objections": [
      "强工具自动带来平等吗",
      "平等是否抹去多样性",
      "AI能回答即能负责吗",
      "岗位减少是否等于创造终结"
    ],
    "voice": "保留作者2024年工具平等论述与2026年智力劳动、知识DNA、生产关系论述",
    "status": "初校；未来充足供应表述为方向，不当作已实现事实",
    "copyedit": "逐章阅读、病句及替换残留修正、长段分段、关键设想与引用归属复查；编辑稿待作者审阅"
  },
