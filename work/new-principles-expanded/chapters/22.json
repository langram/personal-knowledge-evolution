{
  "chapter": "22",
  "title": "科学、教育与文明的持续创造",
  "status": "expanded-copyedited",
  "review": {
    "reasoning": "学习与创造相接→师生角色互换→经验进入公共知识→数学发现与构造→理论创造的训练问题→跨载体智能的条件性探索",
    "examples": [
      "照护者与工程人员共同改进辅助工具",
      "完整推理过程与结论材料的比较",
      "互联身体与分离副本的区别"
    ],
    "objections": [
      "人人参与是否取消专业知识",
      "数学创造是否意味着结论任意",
      "短文本是否必然表示更好理论",
      "未来设想是否可直接当成现有能力"
