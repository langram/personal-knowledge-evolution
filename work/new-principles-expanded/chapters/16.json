{
  "chapter": "16",
  "title": "个人需求与集体资源的两种分配",
  "status": "expanded-copyedited",
  "review": {
    "central_question": "为什么必须分开个人生活需要和共同生产资源的支配",
    "reasoning": "用途区别→需要的差异与适量→共同资源的外部影响→不对等累积→优势者的长期收益→生活保障与真实反馈",
    "examples": [
      "个人饭食与城市储备",
